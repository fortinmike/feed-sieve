# Dev image: based on Microsoft's Dev Container image with .NET 9 SDK and vsdbg preinstalled
FROM mcr.microsoft.com/devcontainers/dotnet:1-9.0

# Set working directory inside container
WORKDIR /app

# Copy csproj and restore first (leverages Docker layer caching)
COPY *.csproj ./
RUN dotnet restore

# Copy the rest of the source
COPY . .

# Expose app and debugger ports
EXPOSE 5000 9012

# Default command: run with hot reload
CMD ["dotnet", "watch", "run", "--urls", "http://0.0.0.0:5000"]
