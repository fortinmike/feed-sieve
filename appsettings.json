{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:6677"
      }
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Enabled": true,
    "Username": "override_this_username_in_appsettings_dot_Local_dot_json",
    "Password": "override_this_password_in_appsettings_dot_Local_dot_json"
  },
  "Secret": "override_this_secret_in_appsettings_dot_Local_dot_json",
  "Cache": true,
  "ReturnCachedFeedOnUpstreamFailure": true
}
