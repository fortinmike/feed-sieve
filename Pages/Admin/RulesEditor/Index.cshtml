@page "/admin/rules"
@model RulesEditorModel
@{
  ViewData["Title"] = "Rules";
}
@section Head {
  <style>
    .rule-regex-overlay b,
    .rule-regex-overlay i,
    .rule-regex-overlay span,
    .rule-regex-overlay u {
      font: inherit;
      letter-spacing: inherit;
      line-height: inherit;
      background: transparent;
      text-decoration: none;
    }

    .rule-regex-overlay b {
      color: #49a0ff;
      font-weight: 600;
    }

    .rule-regex-overlay b.bref {
      color: #7cd2ff;
    }

    .rule-regex-overlay b.g1,
    .rule-regex-overlay b.g2,
    .rule-regex-overlay b.g3,
    .rule-regex-overlay b.g4,
    .rule-regex-overlay b.g5 {
      color: #7ddc9b;
    }

    .rule-regex-overlay span,
    .rule-regex-overlay u {
      color: #ffbf69;
    }

    .rule-regex-overlay i {
      color: #f2c879;
      font-style: normal;
    }

    .rule-regex-overlay .err {
      color: var(--pico-del-color);
      text-decoration: underline wavy;
      text-decoration-thickness: 2px;
      text-decoration-color: currentColor;
    }

    .rule-regex-editor {
      --rule-regex-toggle-size: 1.15rem;
      --rule-regex-toggle-gap: 0.5rem;
      --rule-regex-padding-right: calc(
        var(--rule-regex-padding-x) + var(--rule-regex-toggle-size) + var(--rule-regex-toggle-gap)
      );
    }

    .rule-regex-overlay {
      padding-right: var(--rule-regex-padding-right);
    }

    .rule-regex-editor .rule-input-regex {
      padding-right: var(--rule-regex-padding-right);
    }

    .pico .rule-regex-test-toggle {
      position: absolute;
      top: 50%;
      right: 0.5rem;
      z-index: 3;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: var(--rule-regex-toggle-size);
      height: var(--rule-regex-toggle-size);
      margin: 0;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--pico-muted-color);
      box-shadow: none;
      transform: translateY(-50%);
    }

    .pico .rule-regex-test-toggle:hover,
    .pico .rule-regex-test-toggle:focus-visible,
    .pico .rule-regex-test-toggle.is-active {
      color: var(--pico-color);
    }

    .rule-regex-test-toggle-icon {
      display: block;
      width: 0.85rem;
      height: 0.85rem;
      background-color: currentColor;
      -webkit-mask: url("/images/circle-ellipsis.svg") center / contain no-repeat;
      mask: url("/images/circle-ellipsis.svg") center / contain no-repeat;
    }

    .rule-input-regex-test {
      margin: 0;
    }

    .rule-input-regex-test.is-match {
      border-color: color-mix(in srgb, var(--pico-ins-color) 65%, var(--pico-form-element-border-color));
      background: color-mix(in srgb, var(--pico-ins-color) 15%, var(--pico-form-element-background-color));
    }
  </style>
}
<main class="pico">
  <div class="subpage-header">
    <a href="/admin" class="subpage-back-link" aria-label="Back to admin">
      <span class="subpage-back-icon" aria-hidden="true"></span>
      <span>Back</span>
    </a>
    <h1>Rules</h1>
    <button type="button" id="saveRulesButton" class="subpage-save-button" aria-label="Save rules" title="Save rules">
      <span class="subpage-save-icon" aria-hidden="true"></span>
    </button>
  </div>
  <p id="rulesSummary" class="page-description"></p>
  <form method="post" class="rules-form" id="rulesForm">
    @Html.AntiForgeryToken()
    <input type="hidden" id="RulesJson" name="RulesJson">
    <div id="rulesList" class="rules-list">
      <p id="rulesEmptyState" class="rules-empty" hidden>No rules yet. Add one to start filtering.</p>
    </div>
    <div class="rules-add-action">
      <button type="button" id="addRuleButton" class="rules-add-button" aria-label="Add rule" title="Add rule">
        <span class="rules-add-icon" aria-hidden="true"></span>
      </button>
    </div>
  </form>
  <template id="ruleRowTemplate">
    <article class="rule-row" draggable="true">
      <div class="rule-row-actions">
        <button type="button" class="rule-reorder-handle" aria-label="Drag to reorder" title="Drag to reorder">
          <span class="rule-reorder-icon" aria-hidden="true"></span>
        </button>
        <button type="button" class="rule-delete" aria-label="Delete rule" title="Delete rule">
          <span class="rule-delete-icon" aria-hidden="true"></span>
        </button>
      </div>
      <div class="rule-fields">
        <label class="rule-field">
          <span class="rule-field-label">Rule</span>
          <input type="text" class="rule-input-name" placeholder="Ads and Sponsors">
        </label>
        <label class="rule-field">
          <span class="rule-field-label">Host</span>
          <input type="text" class="rule-input-host" placeholder="example.com (optional)">
        </label>
        <label class="rule-field rule-field-match">
          <span class="rule-field-label">Match</span>
          <select class="rule-input-match">
            <option value="title">Title</option>
            <option value="content">Content</option>
            <option value="all">All</option>
          </select>
        </label>
        <label class="rule-field">
          <span class="rule-field-label">Regex</span>
          <div class="rule-regex-stack">
            <div class="rule-regex-editor">
              <div class="rule-regex-overlay" aria-hidden="true"></div>
              <input
                type="text"
                class="rule-input-regex"
                placeholder="\\bad\\b|sponsor(ed)?"
                spellcheck="false"
                autocapitalize="off"
                autocomplete="off"
                autocorrect="off"
                data-gramm="false"
                data-gramm_editor="false"
                data-enable-grammarly="false"
                data-ms-editor="false">
              <button
                type="button"
                class="rule-regex-test-toggle"
                aria-label="Toggle regex test"
                title="Toggle regex test"
                aria-expanded="false"
                tabindex="-1">
                <span class="rule-regex-test-toggle-icon" aria-hidden="true"></span>
              </button>
            </div>
            <input
              type="text"
              class="rule-input-regex-test"
              placeholder="Test sample text"
              hidden>
            <p class="rule-regex-validation" aria-live="polite"></p>
          </div>
        </label>
      </div>
    </article>
  </template>
  @if (Model.ErrorMessage is not null)
  {
    <p class="rules-error">@Model.ErrorMessage</p>
  }
  @if (Model.SuccessMessage is not null)
  {
    <p class="rules-success">@Model.SuccessMessage</p>
  }
</main>
<script id="initialRulesData" type="application/json">@Html.Raw(Model.InitialRulesJson)</script>
<script src="/vendor/regex-colorizer/regex-colorizer.min.js"></script>
<script>
  (() => {
    const rulesForm = document.getElementById("rulesForm");
    const addRuleButton = document.getElementById("addRuleButton");
    const saveRulesButton = document.getElementById("saveRulesButton");
    const rulesList = document.getElementById("rulesList");
    const rulesEmptyState = document.getElementById("rulesEmptyState");
    const rulesSummary = document.getElementById("rulesSummary");
    const rulesJsonInput = document.getElementById("RulesJson");
    const initialRulesData = document.getElementById("initialRulesData");
    const ruleRowTemplate = document.getElementById("ruleRowTemplate");

    if (!(rulesForm instanceof HTMLFormElement))
      return;
    if (!(addRuleButton instanceof HTMLButtonElement))
      return;
    if (!(saveRulesButton instanceof HTMLButtonElement))
      return;
    if (!(rulesList instanceof HTMLElement))
      return;
    if (!(rulesEmptyState instanceof HTMLElement))
      return;
    if (!(rulesSummary instanceof HTMLElement))
      return;
    if (!(rulesJsonInput instanceof HTMLInputElement))
      return;
    if (!(initialRulesData instanceof HTMLScriptElement))
      return;
    if (!(ruleRowTemplate instanceof HTMLTemplateElement))
      return;

    const regexErrorProbe = document.createElement("div");

    const getRegexAnalysis = pattern => {
      if (pattern === "")
        return { html: "", error: null };

      const html = window.RegexColorizer.colorizePattern(pattern);
      regexErrorProbe.innerHTML = html;
      const errorNode = regexErrorProbe.querySelector(".err");
      if (errorNode instanceof HTMLElement)
        return { html, error: errorNode.getAttribute("title") || "Regex has an invalid token" };

      return { html, error: null };
    };

    const parseInitialRules = () => {
      try {
        const parsed = JSON.parse(initialRulesData.textContent ?? "[]");
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    };

    const normalizeRule = rule => {
      return {
        name: typeof rule?.name === "string" ? rule.name : "",
        host: typeof rule?.host === "string" ? rule.host : "",
        match: typeof rule?.match === "string" ? rule.match : "title",
        regex: typeof rule?.regex === "string" ? rule.regex : ""
      };
    };

    const normalizeMatch = match => {
      return match === "content" || match === "all" ? match : "title";
    };

    const getRuleRowElements = rowElement => {
      if (!(rowElement instanceof HTMLElement))
        return null;

      const nameInput = rowElement.querySelector(".rule-input-name");
      const hostInput = rowElement.querySelector(".rule-input-host");
      const matchInput = rowElement.querySelector(".rule-input-match");
      const regexInput = rowElement.querySelector(".rule-input-regex");
      const regexTestToggle = rowElement.querySelector(".rule-regex-test-toggle");
      const regexTestInput = rowElement.querySelector(".rule-input-regex-test");
      const regexOverlay = rowElement.querySelector(".rule-regex-overlay");
      const regexValidation = rowElement.querySelector(".rule-regex-validation");
      const reorderHandle = rowElement.querySelector(".rule-reorder-handle");
      const deleteButton = rowElement.querySelector(".rule-delete");

      if (!(nameInput instanceof HTMLInputElement))
        return null;
      if (!(hostInput instanceof HTMLInputElement))
        return null;
      if (!(matchInput instanceof HTMLSelectElement))
        return null;
      if (!(regexInput instanceof HTMLInputElement))
        return null;
      if (!(regexTestToggle instanceof HTMLButtonElement))
        return null;
      if (!(regexTestInput instanceof HTMLInputElement))
        return null;
      if (!(regexOverlay instanceof HTMLElement))
        return null;
      if (!(regexValidation instanceof HTMLElement))
        return null;
      if (!(reorderHandle instanceof HTMLButtonElement))
        return null;
      if (!(deleteButton instanceof HTMLButtonElement))
        return null;

      return {
        row: rowElement,
        nameInput,
        hostInput,
        matchInput,
        regexInput,
        regexTestToggle,
        regexTestInput,
        regexOverlay,
        regexValidation,
        reorderHandle,
        deleteButton
      };
    };

    const readDraftRule = rowElements => {
      const rule = {
        name: rowElements.nameInput.value.trim(),
        host: rowElements.hostInput.value.trim(),
        match: rowElements.matchInput.value.trim(),
        regex: rowElements.regexInput.value.trim()
      };

      const hasNoValues = rule.name === "" && rule.host === "" && rule.regex === "";
      if (hasNoValues)
        return null;

      return rule;
    };

    const writeRule = (rowElements, rule) => {
      rowElements.nameInput.value = rule.name;
      rowElements.hostInput.value = rule.host;
      rowElements.matchInput.value = normalizeMatch(rule.match);
      rowElements.regexInput.value = rule.regex;
    };

    const updateEmptyState = () => {
      const hasRows = rulesList.querySelector(".rule-row") !== null;
      rulesList.classList.toggle("is-empty", !hasRows);
      rulesEmptyState.hidden = hasRows;
    };

    const getDraftRules = () => {
      const rows = [...rulesList.querySelectorAll(".rule-row")];
      return rows
        .map(getRuleRowElements)
        .filter(rowElements => rowElements !== null)
        .map(readDraftRule)
        .filter(rule => rule !== null);
    };

    const updateSummary = () => {
      const draftRules = getDraftRules();
      const hostRules = draftRules.filter(rule => rule.host !== "");
      const globalRules = draftRules.length - hostRules.length;
      const distinctHosts = new Set(hostRules.map(rule => rule.host.toLowerCase()));
      const totalRules = draftRules.length;

      rulesSummary.textContent =
        `You have ${hostRules.length} rules covering ${distinctHosts.size} hosts plus ${globalRules} global rules (${totalRules} total)`;
    };

    const createRuleRow = initialRule => {
      const rule = normalizeRule(initialRule);
      const templateRoot = ruleRowTemplate.content.firstElementChild;
      if (!(templateRoot instanceof HTMLElement))
        return null;

      const row = templateRoot.cloneNode(true);
      if (!(row instanceof HTMLElement))
        return null;

      let canDrag = false;
      const rowElements = getRuleRowElements(row);
      if (rowElements === null)
        return row;

      writeRule(rowElements, rule);

      const syncRegexOverlayScroll = () => {
        rowElements.regexOverlay.style.transform = `translateX(${-rowElements.regexInput.scrollLeft}px)`;
      };

      const updateRegexTestState = () => {
        const pattern = rowElements.regexInput.value;
        const sample = rowElements.regexTestInput.value;
        const isInvalidPattern = rowElements.regexInput.classList.contains("is-invalid");
        if (pattern === "" || sample === "" || isInvalidPattern) {
          rowElements.regexTestInput.classList.remove("is-match");
          return;
        }

        let isMatch = false;
        try {
          isMatch = new RegExp(pattern).test(sample);
        } catch {
          isMatch = false;
        }

        rowElements.regexTestInput.classList.toggle("is-match", isMatch);
      };

      const toggleRegexTester = () => {
        const shouldShow = rowElements.regexTestInput.hidden;
        rowElements.regexTestInput.hidden = !shouldShow;
        rowElements.regexTestToggle.setAttribute("aria-expanded", String(shouldShow));
        rowElements.regexTestToggle.classList.toggle("is-active", shouldShow);
        if (shouldShow)
          rowElements.regexTestInput.focus();

        updateRegexTestState();
      };

      const updateRegexUi = () => {
        const pattern = rowElements.regexInput.value;
        if (pattern === "") {
          rowElements.regexOverlay.innerHTML = "";
          rowElements.regexValidation.textContent = "";
          rowElements.regexInput.classList.remove("is-invalid");
          updateRegexTestState();
          syncRegexOverlayScroll();
          return;
        }

        const analysis = getRegexAnalysis(pattern);
        rowElements.regexOverlay.innerHTML = analysis.html;
        rowElements.regexValidation.textContent = analysis.error ?? "";
        rowElements.regexInput.classList.toggle("is-invalid", analysis.error !== null);
        updateRegexTestState();
        syncRegexOverlayScroll();
      };

      rowElements.regexInput.addEventListener("input", updateRegexUi);
      rowElements.regexInput.addEventListener("scroll", syncRegexOverlayScroll);
      rowElements.regexTestToggle.addEventListener("click", toggleRegexTester);
      rowElements.regexTestInput.addEventListener("input", updateRegexTestState);
      requestAnimationFrame(() => {
        if (!row.isConnected)
          return;

        updateRegexUi();
      });

      rowElements.reorderHandle.addEventListener("pointerdown", () => {
        canDrag = true;
      });

      rowElements.deleteButton.addEventListener("click", () => {
        const ruleName = rowElements.nameInput.value.trim();
        const label = ruleName === "" ? "this rule" : `"${ruleName}"`;
        if (!window.confirm(`Delete ${label}?`))
          return;

        row.remove();
        updateEmptyState();
        updateSummary();
      });

      row.addEventListener("dragstart", event => {
        if (!canDrag) {
          event.preventDefault();
          return;
        }

        row.classList.add("is-dragging");
        if (event.dataTransfer) {
          event.dataTransfer.effectAllowed = "move";
          event.dataTransfer.setData("text/plain", "");
        }
      });

      row.addEventListener("pointerup", () => {
        canDrag = false;
      });

      row.addEventListener("pointercancel", () => {
        canDrag = false;
      });

      row.addEventListener("dragend", () => {
        canDrag = false;
        row.classList.remove("is-dragging");
      });

      return row;
    };

    const getDragAfterElement = y => {
      const rows = [...rulesList.querySelectorAll(".rule-row:not(.is-dragging)")];
      return rows.reduce((closest, child) => {
        if (!(child instanceof HTMLElement))
          return closest;

        const box = child.getBoundingClientRect();
        const offset = y - box.top - box.height / 2;
        if (offset >= 0 || offset <= closest.offset)
          return closest;

        return { offset, element: child };
      }, { offset: Number.NEGATIVE_INFINITY, element: null }).element;
    };

    const appendRuleRow = (rule, focusNameInput) => {
      const row = createRuleRow(rule);
      if (!(row instanceof HTMLElement))
        return;

      rulesList.append(row);
      if (!focusNameInput)
        return;

      const rowElements = getRuleRowElements(row);
      if (rowElements !== null)
        rowElements.nameInput.focus();
    };

    addRuleButton.addEventListener("click", () => {
      appendRuleRow({ match: "title" }, true);
      updateEmptyState();
      updateSummary();
    });

    saveRulesButton.addEventListener("click", () => {
      rulesForm.requestSubmit();
    });

    rulesList.addEventListener("input", () => {
      updateSummary();
    });

    rulesList.addEventListener("change", () => {
      updateSummary();
    });

    rulesList.addEventListener("dragover", event => {
      event.preventDefault();
      const dragging = rulesList.querySelector(".rule-row.is-dragging");
      if (!(dragging instanceof HTMLElement))
        return;

      const afterElement = getDragAfterElement(event.clientY);
      if (!(afterElement instanceof HTMLElement)) {
        rulesList.append(dragging);
        return;
      }

      rulesList.insertBefore(dragging, afterElement);
    });

    rulesForm.addEventListener("submit", event => {
      const rules = getDraftRules();

      for (let index = 0; index < rules.length; index++) {
        const rule = rules[index];
        if (rule.name === "" || rule.regex === "") {
          event.preventDefault();
          window.alert("Each rule requires a name and regex");
          return;
        }

        const regexError = getRegexAnalysis(rule.regex).error;
        if (regexError !== null) {
          event.preventDefault();
          window.alert(`Rule ${index + 1} has an invalid regex: ${regexError}`);
          return;
        }
      }

      rulesJsonInput.value = JSON.stringify(rules);
    });

    const initialRules = parseInitialRules();
    if (initialRules.length === 0)
      updateEmptyState();
    else
      initialRules.forEach(rule => appendRuleRow(rule, false));

    updateSummary();
  })();
</script>
