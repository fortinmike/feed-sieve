@page "/admin/rules"
@model RulesEditorModel
@{
  ViewData["Title"] = "Rules";
}
<main class="pico">
  <div class="subpage-header">
    <a href="/admin" class="subpage-back-link" aria-label="Back to admin">
      <span class="subpage-back-icon" aria-hidden="true"></span>
      <span>Back</span>
    </a>
    <h1>Rules</h1>
    <button type="button" id="saveRulesButton" class="subpage-save-button" aria-label="Save rules" title="Save rules">
      <span class="subpage-save-icon" aria-hidden="true"></span>
    </button>
  </div>
  <p id="rulesSummary" class="page-description"></p>
  <form method="post" class="rules-form" id="rulesForm">
    @Html.AntiForgeryToken()
    <input type="hidden" id="RulesJson" name="RulesJson">
    <div id="rulesList" class="rules-list">
      <p id="rulesEmptyState" class="rules-empty" hidden>No rules yet. Add one to start filtering.</p>
    </div>
    <div class="rules-add-action">
      <button type="button" id="addRuleButton" class="rules-add-button" aria-label="Add rule" title="Add rule">
        <span class="rules-add-icon" aria-hidden="true"></span>
      </button>
    </div>
  </form>
  <template id="ruleRowTemplate">
    <article class="rule-row" draggable="true">
      <div class="rule-row-actions">
        <button type="button" class="rule-reorder-handle" aria-label="Drag to reorder" title="Drag to reorder">
          <span class="rule-reorder-icon" aria-hidden="true"></span>
        </button>
        <button type="button" class="rule-delete" aria-label="Delete rule" title="Delete rule">
          <span class="rule-delete-icon" aria-hidden="true"></span>
        </button>
      </div>
      <div class="rule-fields">
        <label class="rule-field">
          <span class="rule-field-label">Rule</span>
          <input type="text" class="rule-input-name" placeholder="Ads and Sponsors">
        </label>
        <label class="rule-field">
          <span class="rule-field-label">Feed</span>
          <input type="text" class="rule-input-feed" placeholder="example.com or https://site.com/feed.xml (optional)">
        </label>
        <label class="rule-field rule-field-match">
          <span class="rule-field-label">Match</span>
          <select class="rule-input-match">
            <option value="title">Title</option>
            <option value="content">Content</option>
            <option value="all">All</option>
          </select>
        </label>
        <label class="rule-field">
          <span class="rule-field-label">Regex</span>
          <div class="rule-regex-stack">
            <div class="rule-regex-editor rule-overlay-editor">
              <div class="rule-regex-overlay rule-overlay" aria-hidden="true"></div>
              <input type="text" class="rule-input-regex rule-overlay-input" placeholder="\\bad\\b|sponsor(ed)?"
                     spellcheck="false" autocapitalize="off" autocomplete="off" autocorrect="off" data-gramm="false"
                     data-gramm_editor="false" data-enable-grammarly="false" data-ms-editor="false">
              <button type="button" class="rule-regex-test-toggle" aria-label="Toggle regex test"
                      title="Toggle regex test" aria-expanded="false" tabindex="-1">
                <span class="rule-regex-test-toggle-icon" aria-hidden="true"></span>
              </button>
            </div>
            <div class="rule-regex-test-editor rule-overlay-editor" hidden>
              <div class="rule-regex-test-overlay rule-overlay" aria-hidden="true"></div>
              <input type="text" class="rule-input-regex-test rule-overlay-input"
                     placeholder="Sample text for testing regex matches" spellcheck="false" autocapitalize="off"
                     autocomplete="off" autocorrect="off" data-gramm="false" data-gramm_editor="false"
                     data-enable-grammarly="false" data-ms-editor="false">
              <button type="button" class="rule-regex101-link" aria-label="Open in regex101" title="Open in regex101"
                      tabindex="-1">
                <span class="rule-regex101-link-icon" aria-hidden="true"></span>
              </button>
            </div>
            <p class="rule-regex-validation" aria-live="polite"></p>
          </div>
        </label>
      </div>
    </article>
  </template>
  @if (Model.ErrorMessage is not null)
  {
    <p class="rules-error">@Model.ErrorMessage</p>
  }
  @if (Model.SuccessMessage is not null)
  {
    <p class="rules-success">@Model.SuccessMessage</p>
  }
</main>
<script id="initialRulesData" type="application/json">@Html.Raw(Model.InitialRulesJson)</script>
<script src="/vendor/regex-colorizer/regex-colorizer.min.js" asp-append-version="true"></script>
<script type="module" src="/js/admin/rules-editor.js" asp-append-version="true"></script>
