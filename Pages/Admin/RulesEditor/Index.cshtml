@page "/admin/rules"
@model RulesEditorModel
@{
  ViewData["Title"] = "Rules";
}
<main class="rules-editor-page">
  <div class="subpage-header">
    <a href="/admin" class="subpage-back-link" aria-label="Back to admin">
      <span class="subpage-back-icon" aria-hidden="true"></span>
      <span>Back</span>
    </a>
    <h1>Rules</h1>
    <button type="button" id="saveRulesButton" class="subpage-save-button" aria-label="Save rules" title="Save rules">
      <span class="subpage-save-icon" aria-hidden="true"></span>
    </button>
  </div>
  @if (Model.ErrorMessage is not null || Model.SuccessMessage is not null)
  {
    <div class="rules-toast-stack" aria-live="polite">
      @if (Model.ErrorMessage is not null)
      {
        <div class="rules-toast rules-toast-error" data-save-toast role="alert">
          <span>@Model.ErrorMessage</span>
          <button type="button" class="rules-toast-close" aria-label="Dismiss notification">×</button>
        </div>
      }
      @if (Model.SuccessMessage is not null)
      {
        <div class="rules-toast rules-toast-success" data-save-toast role="status">
          <span>@Model.SuccessMessage</span>
          <button type="button" class="rules-toast-close" aria-label="Dismiss notification">×</button>
        </div>
      }
    </div>
  }
  <p id="rulesSummary" class="page-description"></p>
  <form method="post" class="rules-form" id="rulesForm">
    @Html.AntiForgeryToken()
    <input type="hidden" id="RulesJson" name="RulesJson">

    <section class="rules-section">
      <div class="rules-section-header">
        <h2>Global</h2>
        <button type="button" id="addGlobalFilterButton" class="rules-add-button" aria-label="Add global filter"
                title="Add global filter">
          <span class="rules-add-icon" aria-hidden="true"></span>
        </button>
      </div>
      <div id="globalFiltersList" class="rules-list">
        <p id="globalFiltersEmptyState" class="rules-empty" hidden>No global filters yet.</p>
      </div>
    </section>

    <section class="rules-section">
      <div class="rules-section-header">
        <h2>Feed-Specific</h2>
        <button type="button" id="addFeedRuleButton" class="rules-add-button" aria-label="Add feed rule"
                title="Add feed rule">
          <span class="rules-add-icon" aria-hidden="true"></span>
        </button>
      </div>
      <div id="feedRulesList" class="feed-rules-list">
        <p id="feedRulesEmptyState" class="rules-empty" hidden>No feed rules yet.</p>
      </div>
    </section>
  </form>

  <template id="filterRowTemplate">
    <div class="rule-row" draggable="true">
      <div class="rule-row-actions">
        <button type="button" class="rule-reorder-handle" aria-label="Drag to reorder" title="Drag to reorder">
          <span class="rule-reorder-icon" aria-hidden="true"></span>
        </button>
        <div class="rule-row-actions-spacer" aria-hidden="true"></div>
        <button type="button" class="rule-delete" aria-label="Delete filter" title="Delete filter">
          <span class="rule-delete-icon" aria-hidden="true"></span>
        </button>
      </div>
      <div class="rule-fields">
        <label class="rule-field">
          <span class="rule-field-label">Name</span>
          <input type="text" class="rule-input-name" placeholder="Ads and Sponsors">
        </label>
        <label class="rule-field rule-field-match">
          <span class="rule-field-label">Match</span>
          <select class="rule-input-match">
            <option value="title">Title</option>
            <option value="content">Content</option>
            <option value="all">All</option>
          </select>
        </label>
        <label class="rule-field">
          <span class="rule-field-label">Regex</span>
          <div class="rule-regex-stack">
            <div class="rule-regex-editor rule-overlay-editor">
              <div class="rule-regex-overlay rule-overlay" aria-hidden="true"></div>
              <input type="text" class="rule-input-regex rule-overlay-input" placeholder="\b(?:advertisement|sponsor)\b"
                     spellcheck="false" autocapitalize="off" autocomplete="off" autocorrect="off" data-gramm="false"
                     data-gramm_editor="false" data-enable-grammarly="false" data-ms-editor="false">
              <button type="button" class="rule-regex-case-toggle" aria-label="Toggle case sensitivity"
                      title="Case-insensitive" aria-pressed="false" tabindex="-1">
                <span class="rule-regex-case-toggle-icon" aria-hidden="true"></span>
              </button>
              <button type="button" class="rule-regex-test-toggle" aria-label="Toggle regex test"
                      title="Toggle regex test" aria-expanded="false" tabindex="-1">
                <span class="rule-regex-test-toggle-icon" aria-hidden="true"></span>
              </button>
            </div>
            <div class="rule-regex-test-editor rule-overlay-editor" hidden>
              <div class="rule-regex-test-overlay rule-overlay" aria-hidden="true"></div>
              <input type="text" class="rule-input-regex-test rule-overlay-input"
                     placeholder="Sample text for testing regex matches" spellcheck="false" autocapitalize="off"
                     autocomplete="off" autocorrect="off" data-gramm="false" data-gramm_editor="false"
                     data-enable-grammarly="false" data-ms-editor="false">
              <button type="button" class="rule-regex101-link" aria-label="Open in regex101" title="Open in regex101"
                      tabindex="-1">
                <span class="rule-regex101-link-icon" aria-hidden="true"></span>
              </button>
            </div>
            <p class="rule-regex-validation" aria-live="polite"></p>
          </div>
        </label>
      </div>
    </div>
  </template>

  <template id="feedRuleTemplate">
    <div class="feed-rule-card" draggable="true">
      <div class="feed-rule-section feed-rule-top">
        <div class="rule-row-actions feed-rule-top-actions">
          <button type="button" class="feed-rule-reorder-handle" aria-label="Drag to reorder" title="Drag to reorder">
            <span class="rule-reorder-icon" aria-hidden="true"></span>
          </button>
          <div class="rule-row-actions-spacer" aria-hidden="true"></div>
          <button type="button" class="feed-rule-delete" aria-label="Delete feed rule" title="Delete feed rule">
            <span class="rule-delete-icon" aria-hidden="true"></span>
          </button>
        </div>
        <div class="rule-fields">
          <label class="rule-field">
            <span class="rule-field-label">Name</span>
            <input type="text" class="feed-rule-input-name" placeholder="Apple News">
          </label>
          <label class="rule-field">
            <span class="rule-field-label">Feed</span>
            <input type="text" class="feed-rule-input-feed" placeholder="Domain, partial URL or full feed URL">
          </label>
          <label class="rule-field feed-summary-field">
            <span class="rule-field-label">Summarize</span>
            <div class="feed-summary-controls">
              <input type="checkbox" class="feed-rule-input-summary-enabled" aria-label="Enable summaries"
                     title="Enable summaries">
              <input type="text" class="feed-rule-input-summary-prompt"
                     placeholder="@Model.SummaryPromptPlaceholder">
            </div>
          </label>
        </div>
      </div>
      <div class="feed-rule-section feed-rule-bottom">
        <div class="rule-fields">
          <div class="rules-list feed-rule-filters-list"></div>
          <button type="button" class="feed-rule-add-filter-button" aria-label="Add feed filter" title="Add feed filter">
            Add Filter
          </button>
        </div>
      </div>
    </div>
  </template>
</main>
<script id="initialRulesData" type="application/json">@Html.Raw(Model.InitialRulesJson)</script>
<script src="/vendor/regex-colorizer/regex-colorizer.min.js" asp-append-version="true"></script>
<script type="module" src="/js/admin/rules-editor.js" asp-append-version="true"></script>
