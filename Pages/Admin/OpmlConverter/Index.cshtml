@page "/admin/opml-converter"
@model OpmlConverterModel
@{
  ViewData["Title"] = "OPML Converter";
}
<main class="pico">
  <div class="subpage-header">
    <a href="/admin" class="subpage-back-link" aria-label="Back to admin">
      <span class="subpage-back-icon" aria-hidden="true"></span>
      <span>Back</span>
    </a>
    <h1>OPML Converter</h1>
  </div>
  @* <p class="page-description">
    Procedure:
  </p> *@
  <ol class="page-description">
    <li>Export your feeds to OPML from your feed reader.</li>
    <li>Convert the OPML to filtered URLs using this converter.</li>
    <li>Import the converted OPML back into your feed reader.</li>
  </ol>
  @* <p class="page-description">
    After that, your feed reader will request filtered feeds from your feed-sieve instance.
  </p> *@
  <form method="post" enctype="multipart/form-data" class="converter-form">
    @Html.AntiForgeryToken()
    <div class="converter-row">
      <div class="converter-file-box">
        <input
          id="OpmlFile"
          name="OpmlFile"
          type="file"
          class="converter-file-input-native"
          accept=".opml,.xml,text/xml,application/xml"
          aria-label="OPML file"
          aria-describedby="opml-file-name">
        <label for="OpmlFile" class="converter-file-trigger">Choose File</label>
        <span id="opml-file-name" class="converter-file-name">No file selected</span>
      </div>
      <button type="submit">Convert</button>
    </div>
  </form>
  @if (Model.ErrorMessage is not null)
  {
    <p class="converter-error">@Model.ErrorMessage</p>
  }
  @if (Model.DownloadUrl is not null)
  {
    <div class="converter-output">
      <p>Converted @Model.ConvertedFeedsCount feed URL(s)</p>
      <a href="@Model.DownloadUrl">Download converted OPML</a>
    </div>
  }
</main>
<script>
  (() => {
    const fileInput = document.getElementById("OpmlFile");
    const fileName = document.getElementById("opml-file-name");
    if (!(fileInput instanceof HTMLInputElement))
      return;
    if (!(fileName instanceof HTMLElement))
      return;

    fileInput.addEventListener("change", () => {
      const selectedFile = fileInput.files?.[0];
      fileName.textContent = selectedFile?.name ?? "No file selected";
    });
  })();
</script>
