@page "/admin"
@model IndexModel
@{
  ViewData["Title"] = "Admin";
}
<main class="pico">
  <h1>Admin</h1>
  <p class="page-description">
    To use feed-sieve, you must subscribe to a feed-sieve URL instead of the original feed URL, for each feed you want
    filtered.
  </p>
  <p class="page-description">
    In practice, this means that if you want all of your feeds to be filtered, you must batch-convert them to
    feed-sieve URLs and re-import them in your feed reader. Afterwards, when you want to subscribe to a new feed, you
    convert the feed to a feed-sieve URL and subscribe to that.
  </p>
  <div class="groups">
    <div class="group">
      <a href="/admin/feed-converter">Single Feed Converter</a>
      <p>Convert a single feed to a feed-sieve URL</p>
    </div>
    <div class="group">
      <a href="/admin/opml-converter">OPML Converter</a>
      <p>Batch-convert your feeds to feed-sieve URLs</p>
    </div>
  </div>
</main>