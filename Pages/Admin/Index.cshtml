@page "/admin"
@model IndexModel
@{
  ViewData["Title"] = "Admin";
}
<main class="pico">
  <h1>Admin</h1>
  <p class="page-description">
    To use feed-sieve, you must subscribe to a feed-sieve URL instead of an original feed URL, for each feed you want
    filtered. The tools below allow you to obtain filtered feeds quickly.
  </p>
  <div class="groups">
    <div class="group">
      <a href="/admin/feed-converter">Single Feed Converter</a>
      <p>Convert a single feed to a feed-sieve URL</p>
    </div>
    <div class="group">
      <a href="/admin/opml-converter">OPML Converter</a>
      <p>Batch-convert your feeds to feed-sieve URLs</p>
    </div>
  </div>
</main>