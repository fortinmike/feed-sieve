@page "/admin/feed-converter"
@model FeedConverterModel
@{
  ViewData["Title"] = "Feed Converter";
}
<main class="pico">
  <h1>Feed Converter</h1>
  <form method="post" class="converter-form">
    @Html.AntiForgeryToken()
    <div class="converter-row">
      <input
        type="url"
        name="FeedUrl"
        value="@Model.FeedUrl"
        placeholder="https://example.com/feed.xml"
        aria-label="Feed URL"
        required>
      <button type="submit">Convert</button>
    </div>
  </form>
  @if (Model.ErrorMessage is not null)
  {
    <p class="converter-error">@Model.ErrorMessage</p>
  }
  @if (Model.FilterUrl is not null)
  {
    <div class="converter-output">
      <p class="page-description">Filtered feed URL</p>
      <div class="converter-result-box">
        <input id="filterUrlOutput" type="text" value="@Model.FilterUrl" readonly>
        <button
          type="button"
          class="converter-copy-button"
          data-copy-target="filterUrlOutput"
          aria-label="Copy filtered feed URL"
          title="Copy">
          <span class="converter-copy-icon" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  }
</main>
<script>
  (() => {
    const copyButtons = document.querySelectorAll(".converter-copy-button");
    copyButtons.forEach(button => {
      const markCopied = () => {
        button.classList.add("is-copied");
        window.setTimeout(() => button.classList.remove("is-copied"), 1200);
      };

      button.addEventListener("click", async () => {
        const targetId = button.getAttribute("data-copy-target");
        if (!targetId)
          return;

        const input = document.getElementById(targetId);
        if (!(input instanceof HTMLInputElement))
          return;

        try {
          await navigator.clipboard.writeText(input.value);
          markCopied();
        } catch {
          input.select();
          document.execCommand("copy");
          input.setSelectionRange(0, 0);
          markCopied();
        }
      });
    });
  })();
</script>
