@page "/admin/feed-converter"
@model FeedConverterModel
@{
  ViewData["Title"] = "Feed Converter";
}
<main class="pico">
  <div class="subpage-header">
    <a href="/admin" class="subpage-back-link" aria-label="Back to admin">
      <span class="subpage-back-icon" aria-hidden="true"></span>
      <span>Back</span>
    </a>
    <h1>Feed Converter</h1>
  </div>
  <ol class="page-description">
    <li>Paste a raw feed URL below.</li>
    <li>Convert the URL.</li>
    <li>Subscribe using the generated URL in your feed reader.</li>
  </ol>
  <form method="post" class="converter-form">
    @Html.AntiForgeryToken()
    <div class="converter-row">
      <input type="url" name="FeedUrl" value="@Model.FeedUrl" placeholder="https://example.com/feed.xml"
             aria-label="Feed URL" required>
      <button type="submit">Convert</button>
    </div>
  </form>
  @if (Model.ErrorMessage is not null)
  {
    <p class="converter-error">@Model.ErrorMessage</p>
  }
  @if (Model.FilterUrl is not null)
  {
    <div class="converter-output">
      <p>Filtered feed URL:</p>
      <div class="converter-result-box">
        <input id="filterUrlOutput" type="text" value="@Model.FilterUrl" readonly>
        <button type="button" class="converter-copy-button" data-copy-target="filterUrlOutput"
                aria-label="Copy filtered feed URL" title="Copy">
          <span class="converter-copy-icon" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  }
</main>
<script src="/js/admin/feed-converter.js" asp-append-version="true"></script>
