@{
  var pageTitle = ViewData["Title"] as string ?? "Feed Sieve";
}

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <title>@pageTitle</title>
  <link rel="stylesheet" href="/vendor/pico/css/pico.conditional.min.css" asp-append-version="true">
  <link rel="stylesheet" href="/css/global.css" asp-append-version="true">
  <link rel="stylesheet" href="/feed-sieve.styles.css" asp-append-version="true">
  @await RenderSectionAsync("Head", required: false)
</head>
<body>
  @RenderBody()
</body>

</html>
