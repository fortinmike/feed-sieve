{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/feed-sieve.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/feed-sieve.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/feed-sieve.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Diff Original vs Modified Feed XML",
      "type": "shell",
      "command": "code",
      "args": ["--diff", "${workspaceFolder}/output/original.xml", "${workspaceFolder}/output/modified.xml"],
      "problemMatcher": []
    }
  ]
}
