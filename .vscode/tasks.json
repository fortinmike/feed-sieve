{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-docker-container",
      "type": "shell",
      "command": "docker compose -f docker-compose.dev.yaml up --build",
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Now listening on: http://0.0.0.0:5000"
        }
      }
    }
  ]
}
