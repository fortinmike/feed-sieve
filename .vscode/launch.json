{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch feed-sieve (Docker)",
      "type": "coreclr",
      "request": "attach",
      "preLaunchTask": "start-docker-container",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": ["exec", "-i", "feed-sieve-dev"],
        "debuggerPath": "/vsdbg",
        "pipeCwd": "${workspaceFolder}"
      },
      "sourceFileMap": {
        "/app": "${workspaceFolder}"
      }
    }
  ]
}
